#!/usr/bin/env python3
"""Watch an in-progress dictation and stop it on a time cap or on silence.

Started by dictate-toggle when recording begins. It reads the growing WAV that
pw-cat is writing, and runs `dictate-toggle` (the normal stop path) when the
recording has run too long or the speaker has stopped talking. Without it, a
shortcut press that never lands leaves the microphone recording into tmpfs.
"""
from __future__ import annotations

import array
import os
import subprocess
import sys
import time

RATE = 16000
BYTES_PER_SAMPLE = 2
WAV_HEADER = 44
POLL_SECONDS = 0.25
# The level check reads only this much trailing audio, kept short so it
# reflects the current instant rather than blending it with whatever came
# before. DICTATE_SILENCE_SECONDS then requires that instant to read quiet on
# every poll for that whole span — using it as the RMS window instead (an
# earlier version of this script did) makes the timeout blend a pause with
# the quieter speech next to it, so it can average out to "quiet" and stop
# the recording well before the speaker has actually gone silent that long.
ANALYSIS_SECONDS = 0.3

# Levels are calibrated against this recording rather than fixed, because a
# usable absolute threshold does not exist: microphone gain differs by an order
# of magnitude between machines, so any constant is either deaf on a quiet mic
# or permanently triggered in a noisy room.
SPEECH_OVER_FLOOR = 4.0     # the speaker must beat the quiet floor by this much
MIN_SPEECH_RMS = 150.0      # ...and be audible in absolute terms, so a silent
                            #    recording is never mistaken for speech
SILENCE_OF_PEAK = 0.15      # quiet, relative to how loud the speaker actually was
SILENCE_OVER_FLOOR = 1.6    # ...or back down near the quietest stretch heard
MAX_SILENCE_OF_PEAK = 0.35  # ceiling for the above, for someone who starts
                            #    talking immediately and leaves no quiet floor


def state_dir() -> str:
    return os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "whisper-dictate")


def toggle_bin() -> str:
    here = os.path.dirname(os.path.abspath(__file__))
    candidate = os.path.join(here, "dictate-toggle")
    return candidate if os.path.isfile(candidate) else "dictate-toggle"


def env_float(name: str, default: float) -> float:
    try:
        return float(os.environ.get(name, "").strip() or default)
    except ValueError:
        return default


def recorder_alive(pidfile: str) -> bool:
    try:
        with open(pidfile, encoding="utf-8") as fh:
            pid = int(fh.read().strip())
    except (OSError, ValueError):
        return False
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    try:
        with open(f"/proc/{pid}/comm", encoding="utf-8") as fh:
            return fh.read().strip() == "pw-cat"
    except OSError:
        return True


def rms(chunk: bytes) -> float | None:
    usable = len(chunk) - (len(chunk) % BYTES_PER_SAMPLE)
    if usable <= 0:
        return None
    samples = array.array("h")
    samples.frombytes(chunk[:usable])
    if sys.byteorder == "big":
        samples.byteswap()
    total = 0
    for value in samples:
        total += value * value
    return (total / len(samples)) ** 0.5


def read_at(wav: str, start: int, length: int) -> bytes | None:
    try:
        with open(wav, "rb") as fh:
            fh.seek(start)
            return fh.read(length)
    except OSError:
        return None


def tail_rms(wav: str, seconds: float) -> float | None:
    """RMS of the last `seconds` of recorded audio, or None if too short."""
    want = int(RATE * seconds) * BYTES_PER_SAMPLE
    try:
        size = os.path.getsize(wav)
    except OSError:
        return None
    audio = size - WAV_HEADER
    if audio < want or want <= 0:
        return None
    # Keep the offset sample-aligned so the frames are not read half a sample off.
    start = WAV_HEADER + ((audio - want) // BYTES_PER_SAMPLE) * BYTES_PER_SAMPLE
    chunk = read_at(wav, start, want)
    return None if chunk is None else rms(chunk)


def duration(wav: str) -> float:
    try:
        return max(0.0, (os.path.getsize(wav) - WAV_HEADER) / (RATE * BYTES_PER_SAMPLE))
    except OSError:
        return 0.0


class SilenceDetector:
    """Decides when the speaker has stopped, calibrating as the recording runs.

    `floor` is the quietest window heard so far and `peak` the loudest, so the
    thresholds land between this room and this voice instead of between two
    numbers picked on someone else's hardware.
    """

    def __init__(self, absolute: float = 0.0) -> None:
        self.absolute = absolute
        self.floor: float | None = None
        self.peak = 0.0
        self.heard_speech = False

    def threshold(self) -> float:
        if self.absolute > 0:
            return self.absolute
        floor = self.floor if self.floor is not None else 0.0
        # Capped at a fraction of the peak: someone who starts talking at once
        # leaves no quiet floor, and an uncapped threshold would then sit above
        # their own voice and report silence immediately.
        return min(
            max(self.peak * SILENCE_OF_PEAK, floor * SILENCE_OVER_FLOOR),
            self.peak * MAX_SILENCE_OF_PEAK,
        )

    def speech_threshold(self) -> float:
        if self.absolute > 0:
            return self.absolute * 2
        floor = self.floor if self.floor is not None else 0.0
        return max(floor * SPEECH_OVER_FLOOR, MIN_SPEECH_RMS)

    def feed(self, level: float) -> bool:
        """Take one reading; True means this instant reads as quiet."""
        self.floor = level if self.floor is None else min(self.floor, level)
        self.peak = max(self.peak, level)
        if self.peak >= self.speech_threshold():
            self.heard_speech = True
        # Before the speaker starts, quiet is just quiet.
        if not self.heard_speech:
            return False
        return level <= self.threshold()


def stop(reason: str) -> None:
    subprocess.Popen(
        [toggle_bin()],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
        env={**os.environ, "DICTATE_STOP_REASON": reason},
    )


def main() -> int:
    root = state_dir()
    wav = os.path.join(root, "dictation.wav")
    pidfile = os.path.join(root, "record.pid")

    max_seconds = env_float("DICTATE_MAX_SECONDS", 600.0)
    silence_seconds = env_float("DICTATE_SILENCE_SECONDS", 0.0)
    # 0 keeps the adaptive thresholds. A positive value pins them, for a setup
    # where the calibration guesses wrong and a fixed number is easier.
    silence_level = env_float("DICTATE_SILENCE_LEVEL", 0.0)

    if max_seconds <= 0 and silence_seconds <= 0:
        return 0

    analysis_seconds = min(ANALYSIS_SECONDS, silence_seconds) if silence_seconds > 0 else ANALYSIS_SECONDS
    detector = SilenceDetector(absolute=silence_level)
    quiet_since: float | None = None
    while True:
        time.sleep(POLL_SECONDS)
        if not recorder_alive(pidfile):
            return 0

        if max_seconds > 0 and duration(wav) >= max_seconds:
            stop("max-seconds")
            return 0

        if silence_seconds <= 0:
            continue

        level = tail_rms(wav, analysis_seconds)
        if level is None:
            continue
        if not detector.feed(level):
            quiet_since = None
            continue
        if quiet_since is None:
            quiet_since = time.monotonic()
        elif time.monotonic() - quiet_since >= silence_seconds:
            stop("silence")
            return 0


if __name__ == "__main__":
    raise SystemExit(main())
