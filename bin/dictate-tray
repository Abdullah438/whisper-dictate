#!/usr/bin/env python3
"""System tray control for whisper-dictate. Left-click starts or stops recording."""
from __future__ import annotations

import os
import subprocess
import sys

if os.geteuid() == 0:
    sys.stderr.write("dictate-tray: refuse to run as root\n")
    raise SystemExit(1)

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gio, GLib, Gtk

APP_ID = "org.whisperdictate.Tray"
ITEM_PATH = "/StatusNotifierItem"
WATCHERS = (
    ("org.kde.StatusNotifierWatcher", "/StatusNotifierWatcher", "org.kde.StatusNotifierWatcher"),
    (
        "org.freedesktop.StatusNotifierWatcher",
        "/StatusNotifierWatcher",
        "org.freedesktop.StatusNotifierWatcher",
    ),
)
ITEM_XML = """
<node>
  <interface name="org.kde.StatusNotifierItem">
    <property name="Category" type="s" access="read"/>
    <property name="Id" type="s" access="read"/>
    <property name="Title" type="s" access="read"/>
    <property name="Status" type="s" access="read"/>
    <property name="WindowId" type="i" access="read"/>
    <property name="IconName" type="s" access="read"/>
    <property name="OverlayIconName" type="s" access="read"/>
    <property name="AttentionIconName" type="s" access="read"/>
    <property name="AttentionMovieName" type="s" access="read"/>
    <property name="ToolTip" type="(sa(iiay)ss)" access="read"/>
    <property name="IconThemePath" type="s" access="read"/>
    <property name="ItemIsMenu" type="b" access="read"/>
    <property name="Menu" type="o" access="read"/>
    <signal name="NewTitle"/>
    <signal name="NewIcon"/>
    <signal name="NewAttentionIcon"/>
    <signal name="NewOverlayIcon"/>
    <signal name="NewToolTip"/>
    <signal name="NewStatus">
      <arg name="status" type="s"/>
    </signal>
    <method name="ContextMenu">
      <arg direction="in" name="x" type="i"/>
      <arg direction="in" name="y" type="i"/>
    </method>
    <method name="Activate">
      <arg direction="in" name="x" type="i"/>
      <arg direction="in" name="y" type="i"/>
    </method>
    <method name="SecondaryActivate">
      <arg direction="in" name="x" type="i"/>
      <arg direction="in" name="y" type="i"/>
    </method>
    <method name="Scroll">
      <arg direction="in" name="delta" type="i"/>
      <arg direction="in" name="orientation" type="s"/>
    </method>
  </interface>
</node>
"""


def state_dir() -> str:
    path = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "whisper-dictate")
    os.makedirs(path, mode=0o700, exist_ok=True)
    return path


def toggle_bin() -> str:
    here = os.path.dirname(os.path.abspath(__file__))
    candidate = os.path.join(here, "dictate-toggle")
    if os.path.isfile(candidate):
        return candidate
    return "dictate-toggle"


def pid_alive(pidfile: str) -> bool:
    try:
        with open(pidfile, encoding="utf-8") as fh:
            pid = int(fh.read().strip())
    except (OSError, ValueError):
        return False
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    return True


class DictationTray:
    def __init__(self) -> None:
        self.connection: Gio.DBusConnection | None = None
        self.registration_id = 0
        self.state = "idle"
        self._menu: Gtk.Menu | None = None

    def current_state(self) -> str:
        root = state_dir()
        if pid_alive(os.path.join(root, "record.pid")):
            return "recording"
        if os.path.isdir(os.path.join(root, "lock.d")):
            return "busy"
        return "idle"

    def visuals(self) -> tuple[str, str, str, str]:
        # icon, attention icon, sni status, tooltip
        if self.state == "recording":
            return (
                "media-record",
                "media-record",
                "NeedsAttention",
                "Recording — click to stop and transcribe",
            )
        if self.state == "busy":
            return (
                "view-refresh",
                "",
                "Active",
                "Transcribing…",
            )
        return (
            "audio-input-microphone",
            "",
            "Active",
            "Whisper Dictation — click to start",
        )

    def prop(self, name: str) -> GLib.Variant | None:
        icon, attention, status, tip = self.visuals()
        values = {
            "Category": GLib.Variant("s", "SystemServices"),
            "Id": GLib.Variant("s", "whisper-dictate"),
            "Title": GLib.Variant("s", "Whisper Dictation"),
            "Status": GLib.Variant("s", status),
            "WindowId": GLib.Variant("i", 0),
            "IconName": GLib.Variant("s", icon),
            "OverlayIconName": GLib.Variant("s", ""),
            "AttentionIconName": GLib.Variant("s", attention),
            "AttentionMovieName": GLib.Variant("s", ""),
            "IconThemePath": GLib.Variant("s", ""),
            "ItemIsMenu": GLib.Variant("b", False),
            "Menu": GLib.Variant("o", "/NO_DBUSMENU"),
            "ToolTip": GLib.Variant("(sa(iiay)ss)", (icon, [], "Whisper Dictation", tip)),
        }
        return values.get(name)

    def emit(self, signal: str, params: GLib.Variant | None = None) -> None:
        if not self.connection:
            return
        self.connection.emit_signal(None, ITEM_PATH, "org.kde.StatusNotifierItem", signal, params)

    def refresh(self) -> bool:
        new_state = self.current_state()
        if new_state != self.state:
            self.state = new_state
            self.emit("NewIcon")
            self.emit("NewAttentionIcon")
            self.emit("NewToolTip")
            _icon, _att, status, _tip = self.visuals()
            self.emit("NewStatus", GLib.Variant("(s)", (status,)))
        return True

    def toggle(self) -> None:
        if self.current_state() == "busy":
            return
        subprocess.Popen(
            [toggle_bin()],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        GLib.timeout_add(150, self.refresh)

    def popup_menu(self, _x: int, _y: int) -> None:
        menu = Gtk.Menu()
        label = {
            "recording": "Stop and transcribe",
            "busy": "Working…",
            "idle": "Start recording",
        }[self.current_state()]
        toggle_item = Gtk.MenuItem(label=label)
        toggle_item.set_sensitive(self.current_state() != "busy")
        toggle_item.connect("activate", lambda *_: self.toggle())
        quit_item = Gtk.MenuItem(label="Quit tray")
        quit_item.connect("activate", lambda *_: Gtk.main_quit())
        menu.append(toggle_item)
        menu.append(Gtk.SeparatorMenuItem())
        menu.append(quit_item)
        menu.show_all()
        self._menu = menu
        menu.popup_at_pointer(None)

    def on_method(
        self,
        _connection,
        _sender,
        _path,
        _iface,
        method: str,
        _params,
        invocation: Gio.DBusMethodInvocation,
    ) -> None:
        if method in {"Activate", "SecondaryActivate"}:
            self.toggle()
        elif method == "ContextMenu":
            x, y = _params.unpack()
            GLib.idle_add(self.popup_menu, x, y)
        invocation.return_value(None)

    def on_get_property(self, _connection, _sender, _path, _iface, name: str):
        return self.prop(name)

    def export(self, connection: Gio.DBusConnection) -> None:
        self.connection = connection
        info = Gio.DBusNodeInfo.new_for_xml(ITEM_XML)
        self.registration_id = connection.register_object(
            ITEM_PATH,
            info.interfaces[0],
            self.on_method,
            self.on_get_property,
            None,
        )
        self.register_with_watcher()
        GLib.timeout_add(400, self.refresh)

    def register_with_watcher(self) -> None:
        if not self.connection:
            return
        names = [self.connection.get_unique_name(), ITEM_PATH, APP_ID]
        for bus_name, path, iface in WATCHERS:
            for service in names:
                try:
                    proxy = Gio.DBusProxy.new_sync(
                        self.connection,
                        Gio.DBusProxyFlags.DO_NOT_LOAD_PROPERTIES,
                        None,
                        bus_name,
                        path,
                        iface,
                        None,
                    )
                    proxy.call_sync(
                        "RegisterStatusNotifierItem",
                        GLib.Variant("(s)", (service,)),
                        Gio.DBusCallFlags.NONE,
                        2500,
                        None,
                    )
                    return
                except GLib.Error:
                    continue
        GLib.timeout_add_seconds(2, self._retry_watcher)

    def _retry_watcher(self) -> bool:
        self.register_with_watcher()
        return False


def run_daemon() -> int:
    Gtk.init([])
    tray = DictationTray()
    tray.state = tray.current_state()

    def on_bus_acquired(connection: Gio.DBusConnection, _name: str) -> None:
        tray.export(connection)

    def on_name_acquired(_connection: Gio.DBusConnection, _name: str) -> None:
        return

    Gio.bus_own_name(
        Gio.BusType.SESSION,
        APP_ID,
        Gio.BusNameOwnerFlags.DO_NOT_QUEUE,
        on_bus_acquired,
        on_name_acquired,
        lambda *_: Gtk.main_quit(),
    )
    Gtk.main()
    return 0


def name_already_owned() -> bool:
    try:
        conn = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        dbus = Gio.DBusProxy.new_sync(
            conn,
            Gio.DBusProxyFlags.NONE,
            None,
            "org.freedesktop.DBus",
            "/org/freedesktop/DBus",
            "org.freedesktop.DBus",
            None,
        )
        return bool(dbus.call_sync("NameHasOwner", GLib.Variant("(s)", (APP_ID,)), Gio.DBusCallFlags.NONE, 1000, None).unpack()[0])
    except GLib.Error:
        return False


def main(argv: list[str]) -> int:
    daemon = "--daemon" in argv or "-d" in argv
    if name_already_owned():
        if daemon:
            return 0
        subprocess.run([toggle_bin()], check=False)
        return 0
    return run_daemon()


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
