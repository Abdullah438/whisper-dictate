# ~/.config/whisper-dictate/config
#
# Sourced by dictate-toggle and rewrite-selection. A desktop global shortcut
# starts those scripts without your shell environment, so this file — not
# ~/.bashrc or ~/.zshrc — is where settings belong. An environment variable of
# the same name still wins over anything here.
#
# Uncomment what you want to change. Full list: dictate-toggle --help

# Whisper
#WHISPER_LANG=en
#WHISPER_MODEL="$HOME/.local/share/whisper.cpp/models/ggml-large-v3-turbo.bin"
#WHISPER_TIMEOUT=120

# Voice activity detection. "auto" uses the Silero model when it is present,
# which removes most "Thank you." hallucinations on near-silent recordings.
#WHISPER_VAD=auto

# Local LLM cleanup
#DICTATE_LLM=1
#DICTATE_LLM_MODEL=mistral:7b

# Stop a recording that has run this long, in case the stop shortcut is missed.
#DICTATE_MAX_SECONDS=600

# Hands-free stop: end the recording after this many seconds of silence.
# 0 disables it. 2.5 is a good starting point.
#DICTATE_SILENCE_SECONDS=0

# What counts as silence. Left at 0, it calibrates against your own microphone
# and voice as the recording runs, which is what you want: usable absolute
# levels differ by an order of magnitude between machines. Set a number here
# only if that guesses wrong for you.
#DICTATE_SILENCE_LEVEL=0

# How the text gets into the focused window.
#
# "type" sends it one keystroke at a time. Universal, but it costs
# DICTATE_KEY_DELAY + DICTATE_KEY_HOLD per character — about 16ms at the
# defaults, so a 300-character transcript takes ~5 seconds to arrive, all of it
# after the transcription has already finished.
#
# "paste" is a single keystroke no matter how long the text is. It needs the
# clipboard on, and some password and payment fields refuse paste entirely.
#DICTATE_INSERT=type

# Which paste chord to send. shift+insert is the default because it is the one
# combination both worlds accept: a GUI text field treats it as paste, while
# Konsole and Alacritty bind it to paste-primary (so the primary selection is
# filled too). ctrl+v works in GUI apps but is quoted-insert in a terminal;
# ctrl+shift+v works in terminals but opens Paste Special in LibreOffice and
# the Markdown preview in VS Code.
#DICTATE_PASTE_KEY=shift+insert

# Typing speed, when DICTATE_INSERT=type. 0 is as fast as ydotool will go, but
# some apps drop or reorder characters when they arrive with no delay.
#DICTATE_KEY_DELAY=8

# How a line break is typed. ydotool sends a newline as Enter, and in a message
# box Enter *sends*, so a two-line rewrite would post half of it and type the
# rest into the next message. shift-enter is the line break those apps expect
# and behaves like Enter in a plain text field. Use "enter" if you only ever
# dictate into editors, or "space" to join every line into one.
#DICTATE_NEWLINE=shift-enter

# Clipboard
#DICTATE_CLIPBOARD=1
