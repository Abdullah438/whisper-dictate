[Desktop Entry]
Type=Application
Name=Whisper Dictation
Comment=Tray icon to start and stop local dictation
Exec=dictate-tray --daemon
Icon=audio-input-microphone
Terminal=false
StartupNotify=false
Categories=Utility;Audio;
Keywords=dictate;speech;whisper;microphone;
X-GNOME-Autostart-enabled=true
X-KDE-autostart-after=panel
